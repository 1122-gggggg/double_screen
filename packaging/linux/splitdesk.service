[Unit]
Description=SplitDesk host daemon
Documentation=https://github.com/splitdesk/splitdesk
After=network-online.target systemd-logind.service
Wants=network-online.target

[Service]
Type=simple
# Daemon only. Never ExecStart Weston, mutter, or any compositor.
# Weston is spawned per session as the session UID (systemd-run --uid=…).
ExecStart=/usr/local/bin/splitdeskd
Restart=on-failure
RestartSec=2

# Control plane: loopback only. Do not change to 0.0.0.0.
Environment=SPLITDESK_BIND=127.0.0.1:9823

# Token path: $XDG_RUNTIME_DIR/splitdesk/daemon.token (mode 0600).
# Leave XDG_RUNTIME_DIR to the daemon/logind. Fallback is /tmp/splitdesk-$UID/.
RuntimeDirectory=splitdesk
RuntimeDirectoryMode=0700
UMask=0077

# Privileged daemon may be root so it can systemd-run --uid= for other users.
# Compositor is never this process. Do not add ExecStart=weston.
# If you set User= here, splitdeskd may only create sessions for that user.
# PrivateTmp is off: token fallback is /tmp/splitdesk-$UID/daemon.token and
# the CLI on the host must read the same file (mode 0600, dir 0700).
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
